        function buttonExplosion(element) {
            const rect = element.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            for (let i = 0; i < 25; i++) {
                const sparkle = document.createElement('div');
                sparkle.className = 'magic-sparkle';
                sparkle.style.width = '8px'; sparkle.style.height = '8px';
                sparkle.style.left = centerX + 'px'; sparkle.style.top = centerY + 'px';
                document.body.appendChild(sparkle);
                const angle = Math.random() * Math.PI * 2;
                const velocity = Math.random() * 90 + 30;
                sparkle.animate([{ transform: 'translate(-50%, -50%) scale(1)', opacity: 1 }, { transform: `translate(calc(-50% + ${Math.cos(angle) * velocity}px), calc(-50% + ${Math.sin(angle) * velocity}px)) scale(0)`, opacity: 0 }], { duration: 700, easing: 'ease-out', fill: 'forwards' });
                setTimeout(() => sparkle.remove(), 700);
            }
        }

