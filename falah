        function toggleTheme() {
            const body = document.body;
            const btn = document.querySelector('.theme-toggle-btn');
            
            if (!body.classList.contains('ghibli-mode') && !body.classList.contains('platform-mode') && !body.classList.contains('forest-mode') && !body.classList.contains('yellow-mode')) {
                body.classList.add('ghibli-mode');
                btn.innerHTML = "🌱 Ghibli Mode";
            } else if (body.classList.contains('ghibli-mode')) {
                body.classList.remove('ghibli-mode');
                body.classList.add('platform-mode');
                btn.innerHTML = "🚂 Platform 9 ¾";
            } else if (body.classList.contains('platform-mode')) {
                body.classList.remove('platform-mode');
                body.classList.add('forest-mode');
                btn.innerHTML = "🍃 Forest Mode";
            } else if (body.classList.contains('forest-mode')) {
                body.classList.remove('forest-mode');
                body.classList.add('yellow-mode');
                btn.innerHTML = "☀️ Sunshine Mode";
            } else {
                body.classList.remove('yellow-mode');
                btn.innerHTML = "🔮 Hogwarts Mode";
            }
        }

